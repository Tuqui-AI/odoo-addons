<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="param_access_log_max_rows" model="ir.config_parameter">
        <field name="key">tuqui.access_log.max_rows</field>
        <field name="value">10000</field>
    </record>

    <!--
        Tuqui frontend activation URL. The /tuqui/activation/start route
        redirects the admin's browser here, appending ?nonce=... &
        companion_url=... in the query string. Override for dev (e.g.
        http://localhost:5173/activate) or staging environments.
    -->
    <record id="param_activation_frontend_url" model="ir.config_parameter">
        <field name="key">tuqui.activation.frontend_url</field>
        <field name="value">https://tuqui.com/activate</field>
    </record>

    <!--
        Tuqui base URL, used to build the "Go to Tuqui" workspace link.
        Not user-facing — clients never point the module elsewhere.
        Override for dev (e.g. http://localhost:5173) or staging.
    -->
    <record id="param_base_url" model="ir.config_parameter">
        <field name="key">tuqui.base_url</field>
        <field name="value">https://tuqui.com</field>
    </record>

</odoo>
