<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuqui_rpc_rule_list" model="ir.ui.view">
        <field name="name">tuqui.rpc.rule.list</field>
        <field name="model">tuqui.rpc.rule</field>
        <field name="arch" type="xml">
            <list string="Tuqui RPC Rules" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="effect"
                       decoration-success="effect == 'allow'"
                       decoration-danger="effect == 'deny'"/>
                <field name="operation_type"/>
                <field name="model_pattern"/>
                <field name="method_pattern"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tuqui_rpc_rule_form" model="ir.ui.view">
        <field name="name">tuqui.rpc.rule.form</field>
        <field name="model">tuqui.rpc.rule</field>
        <field name="arch" type="xml">
            <form string="Tuqui RPC Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Allow account.move read"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="effect" widget="radio"/>
                            <field name="operation_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="model_pattern"
                                   placeholder="e.g. res.partner, account.*, *"/>
                            <field name="method_pattern"
                                   placeholder="e.g. search_read, action_*, *"/>
                        </group>
                    </group>
                    <div invisible="effect != 'allow' or operation_type != 'private_execute'"
                         class="alert alert-warning" role="alert">
                        <strong>Allow rules for private_execute require exact patterns</strong>
                        on both model and method. Wildcards (<code>*</code>, <code>?</code>,
                        <code>[abc]</code>) are rejected at save time — each private
                        method authorization has to be a deliberate named carve-out.
                    </div>
                    <group string="Notes">
                        <field name="note" nolabel="1"
                               placeholder="Why does this rule exist? Linked ticket, business reason, …"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tuqui_rpc_rule_search" model="ir.ui.view">
        <field name="name">tuqui.rpc.rule.search</field>
        <field name="model">tuqui.rpc.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_pattern"/>
                <field name="method_pattern"/>
                <filter name="allow" string="Allow"
                        domain="[('effect', '=', 'allow')]"/>
                <filter name="deny" string="Deny"
                        domain="[('effect', '=', 'deny')]"/>
                <separator/>
                <filter name="active_only" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_effect" string="Effect"
                        context="{'group_by': 'effect'}"/>
                <filter name="group_op_type" string="Operation type"
                        context="{'group_by': 'operation_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_tuqui_rpc_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">tuqui.rpc.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rules yet
            </p>
            <p>
                Rules are evaluated when the policy is in <strong>advanced</strong> mode.
                In <strong>default</strong> mode they exist but are not consulted.
            </p>
        </field>
    </record>

</odoo>
