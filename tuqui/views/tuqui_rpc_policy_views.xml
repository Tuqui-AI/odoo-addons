<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuqui_rpc_policy_form" model="ir.ui.view">
        <field name="name">tuqui.rpc.policy.form</field>
        <field name="model">tuqui.rpc.policy</field>
        <field name="arch" type="xml">
            <form string="Tuqui Security" create="false" delete="false">
                <header>
                    <button name="action_apply_read_only_preset"
                            type="object"
                            string="Apply read-only preset"
                            class="oe_highlight"
                            invisible="policy_mode != 'advanced'"
                            confirm="This adds three deny rules to block writes, executes and private methods. Existing custom rules are preserved. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Security policy</h1>
                    </div>
                    <group>
                        <field name="policy_mode" widget="radio"/>
                        <field name="allow_private_methods"
                               invisible="policy_mode != 'advanced'"/>
                    </group>

                    <div invisible="policy_mode != 'default'"
                         class="alert alert-info" role="alert">
                        <strong>Default mode.</strong> Hardcoded behaviour, no rules
                        consulted. Private (<code>_</code>-prefixed) methods are always
                        blocked. Absolute blocks apply: <code>sudo</code>,
                        <code>with_user</code>/<code>env</code>/<code>company</code>,
                        <code>flush*</code>, <code>invalidate*</code>, and Python dunders.
                        Reads/writes/executes go through Odoo's own ACL for the acting
                        user.
                        <br/><br/>
                        Switch to <strong>Advanced</strong> to author allow/deny rules
                        and grant access to specific private methods.
                    </div>

                    <div invisible="policy_mode != 'advanced'"
                         class="alert alert-warning" role="alert">
                        <strong>Advanced mode.</strong> The rules table is consulted on
                        every call. <strong>Deny wins.</strong> For private methods, an
                        exact allow rule is required (in addition to the checkbox above);
                        wildcards in allow rules for <code>private_execute</code> are
                        rejected at save time.
                        <br/><br/>
                        Manage rules from <em>Tuqui &gt; Rules</em>.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu target. Auto-creates the singleton on first open via the
         model's action_open_form() helper, so a fresh install never
         lands on an empty form. -->
    <record id="action_tuqui_rpc_policy" model="ir.actions.server">
        <field name="name">Tuqui Security</field>
        <field name="model_id" ref="model_tuqui_rpc_policy"/>
        <field name="state">code</field>
        <field name="code">action = env['tuqui.rpc.policy'].action_open_form()</field>
    </record>

</odoo>
