<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tuqui_assistant.Panel">
        <!-- The card stays MOUNTED while panelOpen (iframe included): hiding it
             only adds `o-tuqui-away`, it never unmounts — a remount would spend
             a second single-use SSO nonce → 401, and the conversation would be
             gone. That class fades it out towards its own corner (panel.scss).
             There is no bubble launcher: the systray icon is the switch. -->
        <div t-if="state.panelOpen" class="o-tuqui-panel d-flex flex-column"
             t-ref="panel"
             t-att-class="{ 'o-tuqui-away': state.minimized, 'o-tuqui-expanded': state.expanded }">
            <!-- Header -->
            <div class="o-tuqui-panel-header d-flex align-items-center justify-content-between">
                <button class="btn btn-sm o-tuqui-brand" t-on-click="openInTuqui"
                        t-att-title="openInTuquiLabel" t-att-aria-label="openInTuquiLabel">
                    <img class="o-tuqui-logo me-1"
                         src="/tuqui_assistant/static/img/tuqui-smile.svg" alt=""/>
                    <span class="o-tuqui-title">Tuqui</span>
                </button>
                <span class="o-tuqui-header-actions d-flex align-items-center">
                    <button class="btn btn-sm o-tuqui-expand"
                            t-on-click="state.expanded ? contract : expand"
                            t-att-title="state.expanded ? contractLabel : expandLabel"
                            t-att-aria-label="state.expanded ? contractLabel : expandLabel">
                        <i t-att-class="state.expanded ? 'fa fa-compress' : 'fa fa-expand'"/>
                    </button>
                    <button class="btn btn-sm o-tuqui-hide" t-on-click="hide"
                            t-att-title="hideLabel" t-att-aria-label="hideLabel">
                        <i class="fa fa-times"/>
                    </button>
                </span>
            </div>

            <!-- L1: iframe del SPA de Tuqui (modo embed). Solo si el companion
                 está conectado (slug + estado active). -->
            <t t-if="ui.connected and ui.slug">
                <iframe class="o-tuqui-iframe flex-grow-1"
                        t-ref="iframe"
                        t-att-src="embedUrl"
                        allow="microphone; clipboard-write; clipboard-read"
                        title="Tuqui"/>
            </t>

            <!-- Sin companion conectado: prompt para conectar Tuqui. El chat
                 vive atado a companion (ADR 0001), así que no hay fallback. -->
            <t t-else="">
                <div class="o-tuqui-disconnected flex-grow-1 d-flex flex-column align-items-center justify-content-center text-center p-4">
                    <img class="o-tuqui-logo mb-3" style="width: 48px; opacity: .8;"
                         src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                    <p class="mb-1 fw-bold">Tuqui no está conectado a este Odoo</p>
                    <p class="small text-muted mb-0">
                        Conectá Tuqui (companion) desde Ajustes para usar el asistente desde acá.
                    </p>
                </div>
            </t>
        </div>
    </t>
</templates>
