<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tuqui_assistant.Panel">
        <div t-if="state.panelOpen" class="o-tuqui-panel d-flex flex-column">
            <!-- Header -->
            <div class="o-tuqui-panel-header d-flex align-items-center justify-content-between">
                <span class="o-tuqui-brand d-flex align-items-center">
                    <img class="o-tuqui-logo me-2"
                         src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                    <span class="o-tuqui-title">Tuqui</span>
                </span>
                <button class="btn btn-sm o-tuqui-close" t-on-click="close" title="Cerrar">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <!-- Contexto del registro abierto -->
            <div class="o-tuqui-context small" t-att-class="{ 'o-tuqui-context-empty': !state.context }">
                <i class="fa fa-crosshairs me-1"/>
                <t t-esc="contextLabel"/>
            </div>

            <!-- L1: iframe del SPA de Tuqui (modo embed) -->
            <t t-if="ui.spaUrl">
                <iframe class="o-tuqui-iframe flex-grow-1"
                        t-ref="iframe"
                        t-att-src="embedUrl"
                        allow="microphone; clipboard-write; clipboard-read"
                        title="Tuqui"/>
            </t>

            <!-- Fallback: shell de chat nativo OWL -->
            <t t-else="">
                <div class="o-tuqui-body flex-grow-1 overflow-auto" t-ref="body">
                    <t t-foreach="ui.messages" t-as="m" t-key="m.id">
                        <div class="o-tuqui-msg" t-attf-class="o-tuqui-msg-{{ m.role }}">
                            <div t-if="m.text" class="o-tuqui-bubble" t-esc="m.text"/>

                            <!-- Tarjeta de propuesta (propose-then-apply, estilo Copilot Edits) -->
                            <div t-if="m.proposal" class="o-tuqui-proposal">
                                <div class="o-tuqui-proposal-head">
                                    <i class="fa fa-magic me-1"/>
                                    <t t-esc="fieldsOf(m.proposal).length"/> cambio(s) propuesto(s)
                                </div>
                                <div class="o-tuqui-proposal-fields">
                                    <label t-foreach="fieldsOf(m.proposal)" t-as="f" t-key="f"
                                           class="o-tuqui-field">
                                        <input type="checkbox"
                                               t-att-checked="m.proposal.selected[f]"
                                               t-att-disabled="m.proposal.applied"
                                               t-on-change="(ev) => this.setField(m.proposal, f, ev.target.checked)"/>
                                        <span class="o-tuqui-field-name" t-esc="f"/>
                                        <span class="o-tuqui-field-arrow">→</span>
                                        <span class="o-tuqui-field-val"
                                              t-esc="formatValue(m.proposal.changes[f])"/>
                                    </label>
                                </div>
                                <div t-if="!m.proposal.applied" class="o-tuqui-proposal-actions">
                                    <button class="btn btn-sm o-tuqui-btn-primary"
                                            t-on-click="() => this.applyProposal(m)">
                                        Aplicar al formulario
                                    </button>
                                    <button class="btn btn-sm btn-link text-muted"
                                            t-on-click="() => this.discardProposal(m)">
                                        Descartar
                                    </button>
                                </div>
                                <div t-else="" class="o-tuqui-proposal-done small">
                                    <i class="fa fa-check me-1"/> Resuelto
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="o-tuqui-composer">
                    <textarea class="o-tuqui-input form-control" rows="1"
                              t-model="ui.draft"
                              t-on-keydown="onKeydown"
                              placeholder="Escribile a Tuqui…  (o pegá un JSON de cambios)"/>
                    <button class="btn o-tuqui-send" t-on-click="onSend" title="Enviar">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>
