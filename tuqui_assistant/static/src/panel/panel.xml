<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tuqui_assistant.Panel">
        <div t-if="state.panelOpen" class="o-tuqui-panel d-flex flex-column">
            <!-- Header -->
            <div class="o-tuqui-panel-header d-flex align-items-center justify-content-between">
                <span class="o-tuqui-brand d-flex align-items-center">
                    <img class="o-tuqui-logo me-2"
                         src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                    <span class="o-tuqui-title">Tuqui</span>
                </span>
                <button class="btn btn-sm o-tuqui-close" t-on-click="close" title="Cerrar">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <!-- Contexto del registro abierto -->
            <div class="o-tuqui-context small" t-att-class="{ 'o-tuqui-context-empty': !state.context }">
                <i class="fa fa-crosshairs me-1"/>
                <t t-esc="contextLabel"/>
            </div>

            <!-- L1: iframe del SPA de Tuqui (modo embed). Solo si el companion
                 está conectado (slug + estado active, resueltos del oauth client). -->
            <t t-if="ui.connected and ui.slug">
                <iframe class="o-tuqui-iframe flex-grow-1"
                        t-ref="iframe"
                        t-att-src="embedUrl"
                        allow="microphone; clipboard-write; clipboard-read"
                        title="Tuqui"/>
            </t>

            <!-- Sin companion conectado: prompt para conectar Tuqui. El chat
                 vive atado a companion (ADR 0001), así que no hay fallback. -->
            <t t-else="">
                <div class="o-tuqui-disconnected flex-grow-1 d-flex flex-column align-items-center justify-content-center text-center p-4">
                    <img class="o-tuqui-logo mb-3" style="width: 48px; opacity: .8;"
                         src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                    <p class="mb-1 fw-bold">Tuqui no está conectado a este Odoo</p>
                    <p class="small text-muted mb-0">
                        Conectá Tuqui (companion) desde Ajustes para usar el asistente desde acá.
                    </p>
                </div>
            </t>
        </div>
    </t>
</templates>
