<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_gc_sso_nonces" model="ir.cron">
        <field name="name">Tuqui Assistant: GC SSO nonces</field>
        <field name="model_id" ref="model_tuqui_assistant_sso_nonce"/>
        <field name="state">code</field>
        <field name="code">model._gc_old_nonces()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Who gets the Tuqui icon in the systray. ONE HTTP call per run for the
         whole instance, so the 15-minute cadence costs ~96 requests a day
         regardless of how many users there are. It also bounds how long a seat
         change takes to show up; "Sync now" in Settings and the triggers on
         install / upgrade / activation cover the cases where waiting is not
         acceptable. Fails open: an unreachable Tuqui writes nothing. -->
    <record id="ir_cron_sync_chat_members" model="ir.cron">
        <field name="name">Tuqui Assistant: sync chat members</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._tuqui_sync_chat_access()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
